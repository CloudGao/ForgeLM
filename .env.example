LLM_PLATFORM_DATABASE_URL=sqlite:///./.llm-platform/platform.db
LLM_PLATFORM_API_HOST=127.0.0.1
LLM_PLATFORM_API_PORT=8000
LLM_PLATFORM_API_URL=http://127.0.0.1:8000
LLM_PLATFORM_AGENT_TOKEN=local-development-token
VITE_API_URL=http://127.0.0.1:8000

# Optional Worker-local project storage. Set independently on every Worker.
# LLM_PLATFORM_WORKER_WORKSPACE_ROOT=/data/forgelm
# LLM_PLATFORM_WORKER_LABELS={"location":"gpu-server","project":"microlm"}
# LLM_PLATFORM_WORKER_CAPABILITIES=microlm.workflow.v1

# Optional dataset transfer overrides. scripts/setup.ps1 prepares Windows defaults.
# HF_ENDPOINT=https://hf-mirror.com
# HF_TOKEN=hf_...
# LLM_PLATFORM_HF_CLI=C:\path\to\hf.exe
# LLM_PLATFORM_HFD_SCRIPT=C:\path\to\hfd.sh
# LLM_PLATFORM_ARIA2C=C:\path\to\aria2c.exe
# LLM_PLATFORM_BASH=C:\Program Files\Git\bin\bash.exe
# LLM_PLATFORM_CURL=C:\Windows\System32\curl.exe
# LLM_PLATFORM_GIT=C:\Program Files\Git\cmd\git.exe
